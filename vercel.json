{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "customer-web": {
      "root": "apps/customer-web",
      "outputDirectory": "dist",
      "buildCommand": "pnpm build"
    },
    "admin-web": {
      "root": "apps/admin-web",
      "outputDirectory": "dist",
      "buildCommand": "pnpm build",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "service": "api",
        "path": "/v1/$1"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api",
        "path": "/$1"
      }
    },
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin-web"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin-web",
        "path": "/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "customer-web"
      }
    }
  ]
}
