{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": 1,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "API Gateway & Edge Telemetry",
      "type": "row"
    },
    {
      "title": "HTTP Request Throughput (req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (status)",
          "legendFormat": "Status {{status}}"
        }
      ]
    },
    {
      "title": "API Latency (P50, P95, P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P50 (ms)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P95 (ms)"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P99 (ms)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "title": "Point-of-Sale & Multi-Master Sync Engine",
      "type": "row"
    },
    {
      "title": "Active POS Till Sessions",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 10 },
      "id": 5,
      "targets": [
        {
          "expr": "sum(stokrova_active_till_sessions_count)",
          "legendFormat": "Active Tills"
        }
      ]
    },
    {
      "title": "Offline Outbox Backlog Depth",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 10 },
      "id": 6,
      "targets": [
        {
          "expr": "sum(stokrova_sync_outbox_queue_depth)",
          "legendFormat": "Pending Mutations"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      }
    },
    {
      "title": "POS Checkout Settlement Rate (tx/min)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 10 },
      "id": 7,
      "targets": [
        {
          "expr": "sum(rate(stokrova_pos_settled_transactions_total[1m])) * 60",
          "legendFormat": "Transactions / min"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["stokrova", "enterprise", "retail", "pos", "inventory"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "STOKROVA Enterprise Operations Overview",
  "uid": "stokrova-ops-overview"
}
