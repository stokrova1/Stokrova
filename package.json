{
  "name": "stokrova",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Offline-First Business Operating Platform & Inventory OS",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r --workspace-concurrency=2 run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
