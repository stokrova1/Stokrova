# Application Environment
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# Database (PostgreSQL 18.x)
DATABASE_URL=postgresql://stokrova:stokrova_dev_password@localhost:5432/stokrova_dev
DB_USER=stokrova
DB_PASSWORD=stokrova_dev_password
DB_NAME=stokrova_dev
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# S3-compatible Object Storage (Cloudflare R2 / MinIO)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=stokrova-files
STORAGE_REGION=auto

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
