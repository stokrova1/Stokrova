# Application Environment
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# Database (PostgreSQL 18.x)
DATABASE_URL=postgresql://stokrova:stokrova_dev_password@localhost:5432/stokrova_dev
DB_USER=stokrova
DB_PASSWORD=stokrova_dev_password
DB_NAME=stokrova_dev
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# S3-compatible Object Storage (Cloudflare R2 / MinIO)
# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com (leave blank to keep files in memory)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=stokrova-files
STORAGE_REGION=auto

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Executive AI analyst (any OpenAI-compatible chat completions endpoint)
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-3-flash-preview

# Reload saved workspace records into memory on startup (true/false)
DURABLE_HYDRATE=false

# Shared secret your payment provider uses to sign billing confirmations (x-stokrova-signature: sha256=<hmac>). Blank = all confirmations refused.
BILLING_WEBHOOK_SECRET=

# Owner self-service invoice payments (Paystack / Flutterwave). Blank = that pay button is hidden.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# The "Secret hash" you type in Flutterwave → Settings → Webhooks.
FLUTTERWAVE_WEBHOOK_HASH=
# Where owners land after paying (your workspace address).
APP_PUBLIC_URL=
